# Salin jadi .env.local (dev) atau isi langsung di Vercel Environment Variables.
# Semua NEXT_PUBLIC_* dibakar saat build - kalau berubah, build ulang.

TURSO_URL=libsql://xxx.turso.io        # SQLite cloud (tier gratis). Kosong = file lokal .data/
TURSO_AUTH_TOKEN=                      # dari dashboard Turso

BOT_API_KEY=                           # sama persis dengan BOT_API_KEY di .env bot VPS

DISCORD_CLIENT_ID=                     # dari Discord Developer Portal (application NOXA)
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://<domain>/api/auth/callback

SESSION_SECRET=                        # random 32+ karakter
ADMIN_DISCORD_IDS=                     # Discord ID admin, pisah koma

NEXT_PUBLIC_SITE_URL=https://<subdomain-vercel>.vercel.app
NEXT_PUBLIC_BOT_INVITE=https://discord.com/oauth2/authorize?client_id=...&scope=bot+applications.commands&permissions=277025508352
# QiosPay Gateway (QRIS) - https://my.qiospay.com/langganan
QIOSPAY_API_KEY=                       # API Key qp_live_... dari dashboard QiosPay
QIOSPAY_MERCHANT_ID=873577065778       # Kode merchant toko
QIOSPAY_PRIVATE_KEY=                   # Private Key whsec_... untuk verifikasi webhook
QIOSPAY_API_BASE=https://my.qiospay.com/v1
